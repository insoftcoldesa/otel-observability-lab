# Benchmark crudo (los CSV agregados SI se commitean)
benchmark/results/raw/*.json
benchmark/results/raw/*.csv
!benchmark/results/raw/.gitkeep
# El registro del entorno SI se versiona: el reporte tiene que declarar la
# maquina en la que se midio, y es el unico archivo de raw/ que es evidencia
# en si mismo, no dato crudo.
!benchmark/results/raw/*-entorno.json

