# Copiar a .env  (el .env NO se commitea)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=otel-lab
# Los 3 pilares por OTLP (usar `console` para depurar sin Collector)
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Exemplars: enlazan cada punto del histograma con su trace_id (T3.7)
OTEL_METRICS_EXEMPLAR_FILTER=trace_based
# Sin esto el SDK no engancha el handler que exporta logs por OTLP
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
SERVICE_B_URL=http://service-b:8001
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Solo para correr los servicios fuera de Docker (scripts/dev-fase1.sh):
# puerto del host mapeado al 5432 del contenedor. 15432 porque 5432-5434 suelen
# estar ocupados por un PostgreSQL del sistema.
POSTGRES_HOST_PORT=15432
POSTGRES_DB=inventory
POSTGRES_USER=otel
POSTGRES_PASSWORD=otel_lab_2026
# Fase 5/6
GCP_PROJECT_ID=otel-lab-obap
GCP_REGION=us-central1
AWS_REGION=us-east-1
